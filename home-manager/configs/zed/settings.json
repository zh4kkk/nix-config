{
  "theme": "Tokyo Night Storm",
  "icon_theme": "Colored Zed Icons Theme Dark",

  "ui_font_size": 13,
  "buffer_font_size": 14,
  "buffer_font_family": "JetBrainsMono Nerd Font",

  "autosave": "on_focus_change",
  "format_on_save": "on",
  "soft_wrap": "editor_width",
  "inlay_hints": {
    "enabled": false,
  },
  "scrollbar": {
    "show": "never",
  },

  "telemetry": {
    "metrics": false,
  },

  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "tabs": {
    "git_status": true,
  },
  "project_panel": {
    "dock": "left",
    "default_width": 220,
  },

  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 13,
    "copy_on_select": true,
    "dock": "bottom",
  },
}
