{
  "layer": "top",
  "position": "top",
  "height": 29,
  "margin-top": 4,
  "exclusive": true,
  "modules-left": [],
  "modules-center": [
    "sway/workspaces",
    "custom/sep",
    "clock",
    "custom/sep",
    "cpu",
    "memory",
    "backlight",
    "custom/sep",
    "pulseaudio",
    "bluetooth",
    "network",
    "battery",
    "sway/language",
    "custom/sep",
    "power-profiles-daemon"
  ],
  "modules-right": [],
  "custom/sep": {
    "format": "|",
    "tooltip": false
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "focused": "",
      "urgent": "󰀨"
    }
  },
  "clock": {
    "format": "󰥔 {:%H:%M}",
    "format-alt": "󰃭 {:%d.%m.%Y}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": {
    "interval": 3,
    "format": "󰍛 {usage}%"
  },
  "memory": {
    "interval": 3,
    "format": "󰘚 {used:0.1f}G",
    "tooltip": false
  },
  "backlight": {
    "format": "󰖨 {percent}%",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "kitty -e ncpamixer"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias}",
    "on-click": "kitty -e bluetuith"
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format": "{essid}",
    "on-click": "kitty -e nmtui"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  "sway/language": {
    "format": " {short}",
    "tooltip": false
  },
  "power-profiles-daemon": {
    "format": "󰓅 {profile}",
    "tooltip": false,
    "format-profiles": {
      "performance": "Perf",
      "balanced": "Bal",
      "power-saver": "Eco"
    }
  }
}
