{
  "layer": "top",
  "position": "bottom",
  "exclusive": false,
  "passthrough": false,

  "modules-left": [],
  "modules-center": [],
  "modules-right": [
    "clock",
    "memory",
    "pulseaudio",
    "backlight",
    "sway/language",
    "battery",
    "sway/workspaces"
  ],

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{calendar}"
  },

  "memory": {
    "interval": 2,
    "format": "RAM {used:0.1f}G",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTED",
    "on-click": "kitty -e ncpamixer",
    "scroll-step": 5
  },

  "backlight": {
    "format": "BRT {percent}%",
    "tooltip": false,
    "scroll-step": 5
  },

  "sway/language": {
    "format": "{short}",
    "tooltip": false
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "BAT {capacity}%",
    "format-charging": "CHG {capacity}%"
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "W{name}"
  }
}
